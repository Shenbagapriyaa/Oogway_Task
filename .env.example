# ===================================================
# THE LENNY GROWTH ASSISTANT - ENVIRONMENT CONFIGURATION
# ===================================================

# --- Application Settings ---
APP_NAME="The Lenny Growth Assistant"
DEBUG=false

# --- Persistence Layer (PostgreSQL or SQLite Fallback) ---
# For Supabase / Railway / Docker, supply your PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:your_password@db.xxx.supabase.co:5432/postgres
# Leave blank or commented out to automatically use persistent local SQLite:
DATABASE_URL=

# --- Local LLM Configuration (Mandatory for Local Demo) ---
# Ensure Ollama is installed and running: `ollama run llama3.2`
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Cloud LLM Configurations (Optional) ---
# Anthropic Claude API Key (Claude 3.5 Sonnet / Haiku):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI API Key (GPT-4o / GPT-4o-mini):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
